FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /app

# Install Node.js (v20.x) and npm for frontend bundling during bootJar
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

COPY . .
RUN sed -i 's/\r$//' ./gradlew ./server/gradlew 2>/dev/null || true && \
    chmod +x ./gradlew ./server/gradlew
RUN cd client && npm install
RUN ./gradlew bootJar --no-daemon

FROM eclipse-temurin:21-jre-jammy

WORKDIR /app
COPY --from=build /app/server/build/libs/server-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java","-jar","app.jar","--spring.profiles.active=production"]
