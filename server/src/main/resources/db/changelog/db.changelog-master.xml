<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <!-- Spring Security Users and Roles Module -->
    <changeSet author="saavy" id="security-tables-001">
        <createTable tableName="roles">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="rolesPK"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_ROLE_NAME"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="users">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="usersPK"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_USER_USERNAME"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_USER_EMAIL"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="user_id, role_id" constraintName="user_rolesPK" tableName="user_roles"/>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_roles" constraintName="FK_user_roles_user" referencedColumnNames="id" referencedTableName="users"/>
        <addForeignKeyConstraint baseColumnNames="role_id" baseTableName="user_roles" constraintName="FK_user_roles_role" referencedColumnNames="id" referencedTableName="roles"/>
    </changeSet>
    <changeSet author="saavy" id="security-seed-002">
        <insert tableName="roles">
            <column name="name" value="ROLE_ADMIN"/>
            <column name="description" value="Administrator with full access"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_MANAGER"/>
            <column name="description" value="Manager with invoice &amp; inventory access"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_USER"/>
            <column name="description" value="Standard user"/>
        </insert>
        <insert tableName="users">
            <column name="username" value="admin"/>
            <!-- password is admin123 (BCrypt encoded) -->
            <column name="password" value="$2a$10$7JB720yubVSZvUI0rEqK/.VqGOZTH.ulu33dHOiBE8ByOhJIrdAu2"/>
            <column name="email" value="admin@example.com"/>
            <column name="full_name" value="System Administrator"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="1"/>
        </insert>
    </changeSet>
    <changeSet author="saavy" id="security-seed-003">
        <insert tableName="users">
            <column name="username" value="user"/>
            <!-- password is user123 (BCrypt encoded) -->
            <column name="password" value="$2a$10$uQc8w5Rf8nXWlIha5xC/Iu2MBIFbM9/HrlVC.dTdx9vn6Qqsed3AG"/>
            <column name="email" value="user@example.com"/>
            <column name="full_name" value="Standard User"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE username = 'user')"/>
            <column name="role_id" valueComputed="(SELECT id FROM roles WHERE name = 'ROLE_USER')"/>
        </insert>
    </changeSet>
    <changeSet author="saavy" id="plugin-config-001">
        <createTable tableName="plugin_config">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="plugin_config_pk"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_plugin_config_name"/>
            </column>
            <column name="display_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="dashboard_title" type="VARCHAR(150)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="version" type="VARCHAR(50)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet author="saavy" id="plugin-config-002">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="plugin_config" columnName="dashboard_title"/>
            </not>
        </preConditions>
        <addColumn tableName="plugin_config">
            <column name="dashboard_title" type="VARCHAR(150)"/>
        </addColumn>
    </changeSet>

    <!-- Dynamic Plugin Changelogs -->
    <includeAll path="db/changelog/plugins" errorIfMissingOrEmpty="false"/>

    <!-- Schema Drops & Cleanup (e.g. dropped plugin or core tables) -->
    <includeAll path="db/changelog/drops" errorIfMissingOrEmpty="false"/>
</databaseChangeLog>
