<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <!-- Spring Security Users and Roles Module -->
    <changeSet author="saavy" id="security-tables-001">
        <createTable tableName="roles">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="rolesPK"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_ROLE_NAME"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="users">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="usersPK"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_USER_USERNAME"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_USER_EMAIL"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="user_id, role_id" constraintName="user_rolesPK" tableName="user_roles"/>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_roles" constraintName="FK_user_roles_user" referencedColumnNames="id" referencedTableName="users"/>
        <addForeignKeyConstraint baseColumnNames="role_id" baseTableName="user_roles" constraintName="FK_user_roles_role" referencedColumnNames="id" referencedTableName="roles"/>
    </changeSet>

    <changeSet author="saavy" id="security-seed-002">
        <insert tableName="roles">
            <column name="name" value="ROLE_ADMIN"/>
            <column name="description" value="Administrator with full access"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_MANAGER"/>
            <column name="description" value="Manager with invoice &amp; inventory access"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_USER"/>
            <column name="description" value="Standard user"/>
        </insert>
        <insert tableName="users">
            <column name="username" value="admin"/>
            <!-- password is admin123 (BCrypt encoded) -->
            <column name="password" value="$2a$10$7JB720yubVSZvUI0rEqK/.VqGOZTH.ulu33dHOiBE8ByOhJIrdAu2"/>
            <column name="email" value="admin@example.com"/>
            <column name="full_name" value="System Administrator"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueNumeric="1"/>
            <column name="role_id" valueNumeric="1"/>
        </insert>
    </changeSet>
    <changeSet author="Ramil (generated)" id="1778512693231-1">
        <createTable tableName="product">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="productPK"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="FLOAT(53)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Ramil (generated)" id="1778512693231-2">
        <createTable tableName="stock">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="stockPK"/>
            </column>
            <column name="quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="supplier_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Ramil (generated)" id="1778512693231-3">
        <createTable tableName="supplier">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="supplierPK"/>
            </column>
            <column name="contact_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Ramil (generated)" id="1778512693231-4">
        <addUniqueConstraint columnNames="contact_email" constraintName="UC_SUPPLIERCONTACT_EMAIL_COL" tableName="supplier"/>
    </changeSet>
    <changeSet author="Ramil (generated)" id="1778512693231-5">
        <addForeignKeyConstraint baseColumnNames="product_id" baseTableName="stock" constraintName="FKjghkvw2snnsr5gpct0of7xfcf" deferrable="false" initiallyDeferred="false" referencedColumnNames="id" referencedTableName="product" validate="true"/>
    </changeSet>
    <changeSet author="Ramil (generated)" id="1778512693231-6">
        <addForeignKeyConstraint baseColumnNames="supplier_id" baseTableName="stock" constraintName="FKl2fbubw80ojtirp051oms6piu" deferrable="false" initiallyDeferred="false" referencedColumnNames="id" referencedTableName="supplier" validate="true"/>
    </changeSet>

