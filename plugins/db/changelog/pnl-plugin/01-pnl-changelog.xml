<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- PnL Accounts Table (Chart of Accounts) -->
    <changeSet author="saavy" id="pnl-accounts-001">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="pnl_accounts"/>
            </not>
        </preConditions>
        <createTable tableName="pnl_accounts">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pnl_accounts_pk"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_pnl_account_code"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="subcategory" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- PnL Ledger Entries Table (Canonical Transactional Store) -->
    <changeSet author="saavy" id="pnl-ledger-entries-001">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="pnl_ledger_entries"/>
            </not>
        </preConditions>
        <createTable tableName="pnl_ledger_entries">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pnl_ledger_entries_pk"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="entry_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(10)" defaultValue="USD"/>
            <column name="entity_name" type="VARCHAR(100)" defaultValue="Main"/>
            <column name="reference_id" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="account_id"
                                 baseTableName="pnl_ledger_entries"
                                 constraintName="fk_pnl_ledger_account"
                                 referencedColumnNames="id"
                                 referencedTableName="pnl_accounts"/>
        <createIndex indexName="idx_pnl_ledger_date" tableName="pnl_ledger_entries">
            <column name="entry_date"/>
        </createIndex>
        <createIndex indexName="idx_pnl_ledger_account_date" tableName="pnl_ledger_entries">
            <column name="account_id"/>
            <column name="entry_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
