            <!-- 4. Seed Initial Sample Attendance Logs -->
    <changeSet author="ramil.saavedra" id="attendance-seed-logs" context="dev,demo,test">
    <preConditions onFail="MARK_RAN">
        <sqlCheck expectedResult="0">SELECT COUNT(*) FROM attendance_logs</sqlCheck>
    </preConditions>
    <insert tableName="attendance_logs">
        <column name="employee_id" value="EMP-001"/>
        <column name="employee_name" value="John Doe"/>
        <column name="department" value="Engineering"/>
        <column name="log_timestamp" valueComputed="CURRENT_TIMESTAMP"/>
        <column name="log_type" value="CLOCK_IN"/>
        <column name="verification_method" value="QR_CODE"/>
        <column name="status" value="ON_TIME"/>
        <column name="kiosk_device_id" value="Kiosk-Lobby-Tablet-01"/>
        <column name="notes" value="Punched in via QR badge"/>
    </insert>
    <insert tableName="attendance_logs">
        <column name="employee_id" value="EMP-002"/>
