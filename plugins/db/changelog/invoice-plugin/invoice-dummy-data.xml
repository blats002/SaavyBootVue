    <!-- Synchronize Auto-Increment / Sequences for H2, PostgreSQL, and MySQL -->
    <changeSet author="saavy" id="sync-party-and-invoice-sequences" runAlways="true" context="dev,demo,test">
        <!-- H2 In-Memory / Embedded Engine -->
        <sql dbms="h2">
            ALTER TABLE parties ALTER COLUMN id RESTART WITH 100;
            ALTER TABLE invoices ALTER COLUMN id RESTART WITH 100;
            ALTER TABLE payments ALTER COLUMN id RESTART WITH 100;
        </sql>

        <!-- PostgreSQL Engine -->
        <sql dbms="postgresql">
            SELECT setval(pg_get_serial_sequence('parties', 'id'), COALESCE(MAX(id), 1)) FROM parties;
            SELECT setval(pg_get_serial_sequence('invoices', 'id'), COALESCE(MAX(id), 1)) FROM invoices;
            SELECT setval(pg_get_serial_sequence('payments', 'id'), COALESCE(MAX(id), 1)) FROM payments;
        </sql>

        <!-- MySQL / MariaDB Engine -->
        <sql dbms="mysql,mariadb">
            ALTER TABLE parties AUTO_INCREMENT = 100;
            ALTER TABLE invoices AUTO_INCREMENT = 100;
            ALTER TABLE payments AUTO_INCREMENT = 100;
        </sql>
    </changeSet>
