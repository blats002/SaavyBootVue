<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Tax Categories Table -->
    <changeSet author="saavy" id="tax-categories-table-001">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tax_categories"/>
            </not>
        </preConditions>
        <createTable tableName="tax_categories">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="tax_categoriesPK"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_TAX_CAT_CODE"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="pnl_category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="bir_schedule_line" type="VARCHAR(255)"/>
            <column name="is_deductible" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_default" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="statutory_cap_percent" type="DECIMAL(5, 2)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Vendor Rules Table -->
    <changeSet author="saavy" id="vendor-rules-table-001">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="vendor_rules"/>
            </not>
        </preConditions>
        <createTable tableName="vendor_rules">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="vendor_rulesPK"/>
            </column>
            <column name="pattern" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="tax_category_id" baseTableName="vendor_rules" constraintName="FK_vendor_rules_category" referencedColumnNames="id" referencedTableName="tax_categories"/>
    </changeSet>

    <!-- Invoices Table Columns Migration for Tax Category & CWT -->
    <changeSet author="saavy" id="invoices-tax-category-cols-001">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="invoices"/>
                <not>
                    <columnExists tableName="invoices" columnName="tax_category_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="invoices">
            <column name="tax_category_id" type="BIGINT"/>
            <column name="cwt_2307_amount" type="DECIMAL(38, 2)" defaultValueNumeric="0"/>
            <column name="vat_status" type="VARCHAR(50)" defaultValue="VAT_INCLUSIVE"/>
            <column name="is_deductible" type="BOOLEAN" defaultValueBoolean="true"/>
        </addColumn>
        <addForeignKeyConstraint baseColumnNames="tax_category_id" baseTableName="invoices" constraintName="FK_invoices_tax_category" referencedColumnNames="id" referencedTableName="tax_categories"/>
    </changeSet>

